<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chicken's Joel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #fbf6ef; /* Mismo fondo cálido institucional */
            color: #2c1e1a;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-joel {
            background-color: #2c1e1a !important;
            border-bottom: 3px solid #b83227;
        }
        .navbar-brand {
            color: #f4c430 !important;
            font-weight: bold;
        }
        .nav-link {
            color: rgba(255,255,255,0.85) !important;
        }
        .nav-link:hover {
            color: #f4c430 !important;
        }
        main {
            flex: 1;
        }
        footer {
            background-color: #2c1e1a;
            color: #fff;
            border-top: 2px solid #b83227;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-joel box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-drumstick-bite me-2"></i>Chicken's Joel
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                        </li>
                        @if (User.IsInRole("Administrador") || User.IsInRole("Mesero"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Mesa" asp-action="Index">Gestión de Mesas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Pedido" asp-action="Index">Gestión de Pedidos</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Producto" asp-action="Index">Menú de Productos</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 mt-auto">
        <div class="container">
            &copy; 2026 - Chicken's Joel - Todos los derechos reservados.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>